FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    uvicorn[standard]==0.27.0 \
    asyncpg==0.29.0 \
    pydantic==2.6.0 \
    python-dotenv==1.0.1

COPY api/ api/
COPY config/ config/

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
