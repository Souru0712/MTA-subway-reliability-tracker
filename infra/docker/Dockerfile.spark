FROM apache/spark:3.5.0

USER root

ENV PIP_TRUSTED_HOST="pypi.org pypi.python.org files.pythonhosted.org"
# JAVA_TOOL_OPTIONS is applied by the JVM before any application code runs.
# This disables cert checking in the AWS SDK's bundled Apache HttpClient so
# S3A writes succeed when a network proxy intercepts HTTPS with its own cert.
ENV JAVA_TOOL_OPTIONS="-Dcom.amazonaws.sdk.disableCertChecking=true"

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*

# Import the system CA bundle into the JVM truststore so the AWS SDK (Java)
# can verify S3 SSL certs through the network proxy
RUN update-ca-certificates && \
    find / -name "cacerts" -path "*/jre/*" -o -name "cacerts" -path "*/jdk*" 2>/dev/null | head -1 | \
    xargs -I{} keytool -importcert \
      -noprompt \
      -trustcacerts \
      -alias system-ca-bundle \
      -file /etc/ssl/certs/ca-certificates.crt \
      -keystore {} \
      -storepass changeit || true

RUN pip install --no-cache-dir \
    psycopg2-binary==2.9.9 \
    boto3==1.34.34 \
    python-dotenv==1.0.1

# Bake S3A + Kafka + Postgres JARs into the image so they're always on the classpath
RUN curl -fsSLk -o /opt/spark/jars/hadoop-aws-3.3.4.jar \
      https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -fsSLk -o /opt/spark/jars/aws-java-sdk-bundle-1.12.262.jar \
      https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    curl -fsSLk -o /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.0.jar \
      https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.0/spark-sql-kafka-0-10_2.12-3.5.0.jar && \
    curl -fsSLk -o /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.0.jar \
      https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.0/spark-token-provider-kafka-0-10_2.12-3.5.0.jar && \
    curl -fsSLk -o /opt/spark/jars/kafka-clients-3.4.1.jar \
      https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar && \
    curl -fsSLk -o /opt/spark/jars/commons-pool2-2.11.1.jar \
      https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar && \
    curl -fsSLk -o /opt/spark/jars/postgresql-42.7.0.jar \
      https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.0/postgresql-42.7.0.jar

USER spark
