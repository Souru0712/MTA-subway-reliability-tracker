# MTA
MTA_FEED_URLS=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-ace,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-nqrw,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-bdfm,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-jz,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-l,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-g,https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-si
MTA_STATIC_GTFS_URL=http://web.mta.info/developers/data/nyct/subway/google_transit.zip

# Kafka (Redpanda)
# VM setup (Hetzner): leave KAFKA_BOOTSTRAP_SERVERS as localhost:9092 — docker-compose overrides internally
#                     set REDPANDA_ADVERTISE_ADDR to the Hetzner public IP so external clients reconnect correctly
# Laptop setup: set KAFKA_BOOTSTRAP_SERVERS to <hetzner-ip>:19092
KAFKA_BOOTSTRAP_SERVERS=<hetzner-ip>:19092
REDPANDA_ADVERTISE_ADDR=<hetzner-ip>
KAFKA_TOPIC_TRIP_UPDATES=mta.trip_updates
KAFKA_TOPIC_VEHICLE_POSITIONS=mta.vehicle_positions
KAFKA_TOPIC_ALERTS=mta.alerts

# Postgres
POSTGRES_MTA_DSN=postgresql://mta:mta@localhost:5432/mta

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=mta-reliability-tracker
# Must use s3a:// — Spark's native S3 scheme. s3:// is not supported.
SPARK_CHECKPOINT_BASE=s3a://mta-reliability-tracker/checkpoints/mta

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MTA
SNOWFLAKE_ROLE=MTA_TRANSFORMER

# Prefect (orchestration — replaces Airflow)
# Set via: prefect cloud login (no env vars needed here)
